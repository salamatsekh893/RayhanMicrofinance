                                    <input type="text" id="bm_pincode" placeholder="e.g. 731101"
                                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-blue-500 text-xs">
                                </div>
                                <div>
                                    <label class="block font-black text-slate-700 uppercase mb-1">Area / Regional Zone</label>
                                    <input type="text" id="bm_areaName" placeholder="e.g. Birbhum Central Zone"
                                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-blue-500 text-xs">
                                </div>

                                <div>
                                    <label class="block font-black text-slate-700 uppercase mb-1">Vault Cash In-Hand (â‚¹)</label>
                                    <input type="number" step="0.01" id="bm_cashBalance" value="0.00"
                                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-mono font-bold text-slate-900 focus:bg-white focus:outline-blue-500 text-xs">
                                </div>
                                <div>
                                    <label class="block font-black text-slate-700 uppercase mb-1">Bank Current Balance (â‚¹)</label>
                                    <input type="number" step="0.01" id="bm_bankBalance" value="0.00"
                                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-mono font-bold text-slate-900 focus:bg-white focus:outline-blue-500 text-xs">
                                </div>
                            </div>

                            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                                <button type="button" onclick="closeBranchModal()" class="px-5 py-2.5 rounded-xl font-black text-slate-600 bg-slate-100 hover:bg-slate-200 transition uppercase tracking-wider text-xs cursor-pointer">
                                    CANCEL
                                </button>
                                <button type="submit" class="px-6 py-2.5 rounded-xl font-black text-white bg-blue-600 hover:bg-blue-700 shadow-md shadow-blue-600/30 transition uppercase tracking-wider text-xs cursor-pointer flex items-center gap-2">
                                    <i class="fa-solid fa-floppy-disk"></i>
                                    <span id="bm_submitBtnText">SAVE BRANCH</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- VIEW 10: STAFF & EMPLOYEES -->
                <div id="view-employees" class="tab-view space-y-6 hidden">
                    <div class="bg-white p-5 rounded-3xl border-2 border-slate-200/90 shadow-sm">
                        <h3 class="text-base font-black text-slate-900 uppercase tracking-wider">STAFF DIRECTORY & HUMAN RESOURCES</h3>
                        <p class="text-xs font-bold text-slate-400 uppercase">BRANCH MANAGERS, FIELD OFFICERS, CASHIERS & RECOVERY AGENTS</p>
                    </div>

                    <div class="bg-white rounded-3xl border-2 border-slate-200/90 shadow-md overflow-hidden">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-50 border-b-2 border-slate-200 text-slate-600 uppercase tracking-wider font-black">
                                    <th class="py-3.5 px-4">EMPLOYEE CODE</th>
                                    <th class="py-3.5 px-4">FULL NAME</th>
                                    <th class="py-3.5 px-4">DESIGNATION & ROLE</th>
                                    <th class="py-3.5 px-4">ASSIGNED BRANCH</th>
                                    <th class="py-3.5 px-4">EMAIL & PHONE</th>
                                    <th class="py-3.5 px-4 text-right">BASIC SALARY (â‚¹)</th>
                                </tr>
                            </thead>
                            <tbody id="employeesTableBody" class="divide-y divide-slate-100 font-bold text-slate-700">
                                <!-- Populated via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- VIEW 11: REPORTS & AUDIT -->
                <div id="view-reports" class="tab-view space-y-6 hidden">
                    <div class="bg-white p-5 rounded-3xl border-2 border-slate-200/90 shadow-sm">
                        <h3 class="text-base font-black text-slate-900 uppercase tracking-wider">FINANCIAL AUDIT, COMPLIANCE & EXPORTS</h3>
                        <p class="text-xs font-bold text-slate-400 uppercase">EXPORT COMPLETE AUDIT STATEMENTS, PORTFOLIO LEDGERS, AND OVERDUE LISTS</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <div class="bg-white p-6 rounded-3xl border-2 border-emerald-100 shadow-md space-y-3">
                            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl font-black border border-emerald-200">
                                <i class="fa-solid fa-file-invoice"></i>
                            </div>
                            <h4 class="font-black text-slate-900 text-sm uppercase">LOAN PORTFOLIO LEDGER</h4>
                            <p class="text-xs font-bold text-slate-500 uppercase">Complete listing of all active & closed loans with remaining principal & interest.</p>
                            <button onclick="exportLoanPortfolioCsv()" class="w-full py-2.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-black uppercase rounded-2xl border border-emerald-200 transition">
                                <i class="fa-solid fa-file-csv mr-1.5"></i> EXPORT TO CSV
                            </button>
                        </div>

                        <div class="bg-white p-6 rounded-3xl border-2 border-blue-100 shadow-md space-y-3">
                            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center text-xl font-black border border-blue-200">
                                <i class="fa-solid fa-calendar-check"></i>
                            </div>
                            <h4 class="font-black text-slate-900 text-sm uppercase">DAILY CASHIER DAY BOOK</h4>
                            <p class="text-xs font-bold text-slate-500 uppercase">Chronological cash book for all collections, disbursements, and expenses.</p>
                            <button onclick="window.print()" class="w-full py-2.5 bg-blue-50 hover:bg-blue-100 text-blue-800 text-xs font-black uppercase rounded-2xl border border-blue-200 transition">
                                <i class="fa-solid fa-print mr-1.5"></i> PRINT DAY SHEET
                            </button>
                        </div>

                        <div class="bg-white p-6 rounded-3xl border-2 border-rose-100 shadow-md space-y-3">
                            <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-700 flex items-center justify-center text-xl font-black border border-rose-200">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </div>
                            <h4 class="font-black text-slate-900 text-sm uppercase">DELINQUENT AGING REPORT</h4>
                            <p class="text-xs font-bold text-slate-500 uppercase">Delinquent borrowers past 30, 60, 90 days grace period for recovery team.</p>
                            <button onclick="alert('Exporting overdue list...')" class="w-full py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-800 text-xs font-black uppercase rounded-2xl border border-rose-200 transition">
                                <i class="fa-solid fa-download mr-1.5"></i> DOWNLOAD RECOVERY LIST
                            </button>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>
</div>

    <!-- COMPANY SETUP MODAL -->
    <div id="companyModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 hidden">
        <div class="bg-white rounded-3xl border-2 border-slate-200 shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 space-y-6">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-600 text-lg">
                        <i class="fa-solid fa-building"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black text-slate-900 uppercase tracking-tight">COMPANY PROFILE & SETTINGS</h3>
                        <p class="text-[11px] font-bold text-slate-400 uppercase">Set your registered enterprise legal name, code, tax & address</p>
                    </div>
                </div>
                <button type="button" onclick="closeCompanyModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition cursor-pointer">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <form id="formCompanyProfile" onsubmit="event.preventDefault(); saveCompanyProfile();" class="space-y-4 text-xs">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label class="block font-black text-slate-700 uppercase mb-1">Company Legal Name *</label>
                        <input type="text" id="compName" required placeholder="e.g. Subidha Microfinance Private Limited"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-emerald-500 text-xs">
                    </div>

                    <div>
                        <label class="block font-black text-slate-700 uppercase mb-1">Company Short Code *</label>
                        <input type="text" id="compCode" required placeholder="e.g. SUB-MF"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-emerald-500 text-xs uppercase">
                    </div>

                    <div>
                        <label class="block font-black text-slate-700 uppercase mb-1">Registration / CIN Number</label>
                        <input type="text" id="compRegNo" placeholder="e.g. U65999WB2026PTC123456"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-emerald-500 text-xs uppercase">
                    </div>

                    <div>
                        <label class="block font-black text-slate-700 uppercase mb-1">PAN / Tax / GST Number</label>
                        <input type="text" id="compTaxNo" placeholder="e.g. 19AABCR1234F1Z5"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-emerald-500 text-xs uppercase">
                    </div>

                    <div>
                        <label class="block font-black text-slate-700 uppercase mb-1">Official Contact Phone</label>
                        <input type="tel" id="compPhone" placeholder="e.g. +91 98765 43210"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-emerald-500 text-xs">
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block font-black text-slate-700 uppercase mb-1">Official Email Address</label>
                        <input type="email" id="compEmail" placeholder="e.g. contact@subidhamicrofinance.com"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-emerald-500 text-xs">
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block font-black text-slate-700 uppercase mb-1">Registered Head Office Address</label>
                        <textarea id="compAddress" rows="2" placeholder="e.g. Holding No. 45, Station Road, Main Bazar"
                                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-emerald-500 text-xs"></textarea>
                    </div>

                    <div>
                        <label class="block font-black text-slate-700 uppercase mb-1">City / Town</label>
                        <input type="text" id="compCity" placeholder="e.g. Kolkata"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-emerald-500 text-xs">
                    </div>

                    <div>
                        <label class="block font-black text-slate-700 uppercase mb-1">State / Province</label>
                        <input type="text" id="compState" placeholder="e.g. West Bengal"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-emerald-500 text-xs">
                    </div>

                    <div>
                        <label class="block font-black text-slate-700 uppercase mb-1">Pincode / Postal Code</label>
                        <input type="text" id="compPincode" placeholder="e.g. 700001"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 focus:bg-white focus:outline-emerald-500 text-xs">
                    </div>

                    <div>
                        <label class="block font-black text-slate-700 uppercase mb-1">Currency Symbol & Code</label>
                        <div class="flex gap-2">
                            <input type="text" id="compCurrencySymbol" value="₹" placeholder="₹"
                                   class="w-16 px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-black text-center text-slate-900 text-xs">
                            <input type="text" id="compCurrencyCode" value="INR" placeholder="INR"
                                   class="flex-1 px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50 font-bold text-slate-900 text-xs uppercase">
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" onclick="closeCompanyModal()" class="px-5 py-2.5 rounded-xl font-black text-slate-600 bg-slate-100 hover:bg-slate-200 transition uppercase tracking-wider text-xs cursor-pointer">
                        CANCEL
                    </button>
                    <button type="submit" class="px-6 py-2.5 rounded-xl font-black text-white bg-emerald-600 hover:bg-emerald-700 shadow-lg shadow-emerald-600/30 transition uppercase tracking-wider text-xs cursor-pointer flex items-center gap-2">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>SAVE COMPANY PROFILE</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

@section Scripts {
    <script src="~/js/microfinance.js" asp-append-version="true"></script>
}
