                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Gender</label>
                        <select id="newCustGender" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl">
                            <option value="2">Female</option>
                            <option value="1">Male</option>
                            <option value="3">Other</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Center & Group</label>
                        <select id="newCustCenter" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl">
                            <!-- populated dynamically -->
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Occupation & Income</label>
                        <input id="newCustOccupation" type="text" value="Dairy / Small Shop" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl" placeholder="Occupation" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Aadhaar Card Number *</label>
                        <input id="newCustAadhaar" type="text" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl" placeholder="12-digit Aadhaar" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">PAN / Voter ID (Optional)</label>
                        <input id="newCustPan" type="text" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl" placeholder="PAN Number" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block font-semibold text-slate-600 mb-1">Residential Address *</label>
                        <input id="newCustAddress" type="text" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl" placeholder="Full Address, Village, Pincode" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Nominee Name</label>
                        <input id="newCustNominee" type="text" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl" placeholder="Nominee Name" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Guarantor Name</label>
                        <input id="newCustGuarantor" type="text" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl" placeholder="Guarantor Name" />
                    </div>
                </div>

                <div class="flex items-center justify-end space-x-2 pt-3 border-t border-slate-100">
                    <button type="button" onclick="closeModal('modalRegisterCustomer')" class="px-4 py-2 bg-slate-100 text-slate-700 font-semibold rounded-xl hover:bg-slate-200 transition">Cancel</button>
                    <button type="submit" class="px-5 py-2 bg-brand-600 text-white font-bold rounded-xl hover:bg-brand-700 transition">Save & Verify Member</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Apply Loan -->
    <div id="modalApplyLoan" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-6 border border-slate-100">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="font-bold text-base text-slate-900 flex items-center">
                    <i class="fa-solid fa-file-signature text-brand-600 mr-2"></i> New Loan Application
                </h3>
                <button onclick="closeModal('modalApplyLoan')" class="text-slate-400 hover:text-slate-600 p-1">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <form id="formApplyLoan" onsubmit="event.preventDefault(); submitApplyLoan();" class="space-y-4 pt-4 text-xs">
                <div>
                    <label class="block font-semibold text-slate-600 mb-1">Select Member (Borrower) *</label>
                    <select id="applyLoanCustomerSelect" required class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-medium">
                        <!-- populated via JS -->
                    </select>
                </div>

                <div>
                    <label class="block font-semibold text-slate-600 mb-1">Loan Scheme / Product *</label>
                    <select id="applyLoanSchemeSelect" onchange="onSchemeChange()" required class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-medium">
                        <!-- populated via JS -->
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Requested Amount (₹) *</label>
                        <input id="applyLoanAmount" type="number" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-bold text-sm" placeholder="₹30,000" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Tenure (Months) *</label>
                        <input id="applyLoanTenure" type="number" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-bold text-sm" value="12" />
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-slate-600 mb-1">Purpose of Loan *</label>
                    <input id="applyLoanPurpose" type="text" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl" placeholder="e.g. Small tailoring business, buffalo purchase" />
                </div>

                <div class="p-3 bg-brand-50/60 rounded-xl border border-brand-100 text-brand-900 space-y-1">
                    <p class="font-bold flex items-center"><i class="fa-solid fa-circle-info text-brand-600 mr-1.5"></i> EMI Terms</p>
                    <p id="applyLoanSchemePreview" class="text-[11px] text-brand-800">Select a scheme to view interest rate and frequency.</p>
                </div>

                <div class="flex items-center justify-end space-x-2 pt-3 border-t border-slate-100">
                    <button type="button" onclick="closeModal('modalApplyLoan')" class="px-4 py-2 bg-slate-100 text-slate-700 font-semibold rounded-xl hover:bg-slate-200 transition">Cancel</button>
                    <button type="submit" class="px-5 py-2 bg-brand-600 text-white font-bold rounded-xl hover:bg-brand-700 transition">Submit Application</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Approve Loan -->
    <div id="modalApproveLoan" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 border border-slate-100">
            <h3 class="font-bold text-base text-slate-900 mb-2">Approve Loan Application</h3>
            <p id="approveLoanSubtitle" class="text-xs text-slate-500 mb-4">Loan Account: ...</p>
            <input type="hidden" id="approveLoanId" />

            <div class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold text-slate-600 mb-1">Approved Amount (₹)</label>
                    <input id="approveLoanAmount" type="number" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-bold text-sm" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-600 mb-1">Approval Remarks</label>
                    <input id="approveLoanRemarks" type="text" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl" placeholder="Eligible per KYC and credit check" />
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-5">
                <button onclick="closeModal('modalApproveLoan')" class="px-3 py-1.5 bg-slate-100 text-slate-700 font-semibold rounded-xl text-xs">Cancel</button>
                <button onclick="confirmApproveLoan()" class="px-4 py-1.5 bg-brand-600 text-white font-bold rounded-xl text-xs">Confirm Approval</button>
            </div>
        </div>
    </div>

    <!-- Modal: Disburse Loan -->
    <div id="modalDisburseLoan" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 border border-slate-100">
            <h3 class="font-bold text-base text-slate-900 mb-1">Disburse Loan</h3>
            <p id="disburseLoanSubtitle" class="text-xs text-slate-500 mb-4">Auto-generates EMI schedule and ledger voucher.</p>
            <input type="hidden" id="disburseLoanId" />

            <div class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold text-slate-600 mb-1">Disbursement Amount (₹)</label>
                    <input id="disburseLoanAmount" type="number" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-bold text-sm" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-600 mb-1">Payment Mode</label>
                    <select id="disburseLoanMode" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium">
                        <option value="1">Cash in Hand</option>
                        <option value="2">Bank Account Transfer</option>
                        <option value="4">UPI / Direct Debit</option>
                    </select>
                </div>
                <div>
                    <label class="block font-semibold text-slate-600 mb-1">First EMI Date</label>
                    <input id="disburseFirstEmiDate" type="date" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl" />
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-5">
                <button onclick="closeModal('modalDisburseLoan')" class="px-3 py-1.5 bg-slate-100 text-slate-700 font-semibold rounded-xl text-xs">Cancel</button>
                <button onclick="confirmDisburseLoan()" class="px-4 py-1.5 bg-brand-600 text-white font-bold rounded-xl text-xs">Disburse & Post Voucher</button>
            </div>
        </div>
    </div>

    <!-- Modal: View Loan Schedule / Passbook -->
    <div id="modalLoanSchedule" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl p-6 border border-slate-100 flex flex-col max-h-[85vh]">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 flex-shrink-0">
                <div>
                    <h3 id="scheduleLoanTitle" class="font-bold text-base text-slate-900">Loan Repayment Passbook & EMI Schedule</h3>
                    <p id="scheduleLoanSubtitle" class="text-xs text-slate-500">Loan #</p>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="window.print()" class="px-3 py-1.5 bg-slate-100 text-slate-700 rounded-xl text-xs font-semibold hover:bg-slate-200 transition">
                        <i class="fa-solid fa-print mr-1"></i> Print Passbook
                    </button>
                    <button onclick="closeModal('modalLoanSchedule')" class="text-slate-400 hover:text-slate-600 p-1">
                        <i class="fa-solid fa-xmark text-base"></i>
                    </button>
                </div>
            </div>

            <div class="flex-1 overflow-y-auto mt-4">
                <table class="w-full text-left border-collapse text-xs">
                    <thead class="sticky top-0 bg-slate-50 border-b border-slate-200">
                        <tr class="text-slate-500 uppercase font-semibold">
                            <th class="py-2.5 px-3">#</th>
                            <th class="py-2.5 px-3">Due Date</th>
                            <th class="py-2.5 px-3 text-right">Principal</th>
                            <th class="py-2.5 px-3 text-right">Interest</th>
                            <th class="py-2.5 px-3 text-right font-bold">Total EMI</th>
                            <th class="py-2.5 px-3 text-right">Paid</th>
                            <th class="py-2.5 px-3 text-right">Outstanding</th>
                            <th class="py-2.5 px-3 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody id="scheduleTableBody" class="divide-y divide-slate-100 text-slate-700 font-medium">
                        <!-- populated via JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal: Thermal / Standard Receipt Printing -->
    <div id="modalReceipt" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 border border-slate-100 text-xs font-mono space-y-4">
            <div class="text-center border-b border-dashed border-slate-300 pb-3">
                <h4 class="font-extrabold text-sm text-slate-900">RPS RAYHAN TECH</h4>
                <p class="text-[10px] text-slate-500">Microfinance Services</p>
                <p id="receiptBranchName" class="text-[10px] text-slate-600 font-bold">Head Office Branch</p>
                <p class="text-[10px] text-slate-400">GST: 19AABCR1234F1Z5</p>
            </div>

            <div class="space-y-1 text-[11px] text-slate-700">
                <div class="flex justify-between"><span class="text-slate-500">Receipt No:</span><span id="rcpNumber" class="font-bold">RCP-0001</span></div>
                <div class="flex justify-between"><span class="text-slate-500">Date & Time:</span><span id="rcpDate">--</span></div>
                <div class="flex justify-between"><span class="text-slate-500">Member:</span><span id="rcpCustomer" class="font-bold">--</span></div>
                <div class="flex justify-between"><span class="text-slate-500">Loan No:</span><span id="rcpLoanNo">--</span></div>
                <div class="flex justify-between"><span class="text-slate-500">Payment Mode:</span><span id="rcpMode">Cash</span></div>
            </div>

            <div class="border-t border-b border-dashed border-slate-300 py-2 space-y-1 text-[11px]">
                <div class="flex justify-between font-bold text-slate-900 text-sm">
                    <span>AMOUNT RECEIVED:</span>
                    <span id="rcpAmount">₹0.00</span>
                </div>
                <div class="flex justify-between text-[10px] text-slate-500">
                    <span>Principal Repaid:</span>
                    <span id="rcpPrincipal">₹0.00</span>
                </div>
                <div class="flex justify-between text-[10px] text-slate-500">
                    <span>Interest:</span>
                    <span id="rcpInterest">₹0.00</span>
                </div>
            </div>

            <div class="text-center text-[10px] text-slate-500 pt-1 space-y-1">
                <p>Thank you for timely repayment!</p>
                <p>Helpline: +91 98765 43210</p>
            </div>

            <div class="flex justify-end gap-2 pt-2 border-t border-slate-100 font-sans">
                <button onclick="closeModal('modalReceipt')" class="px-3 py-1.5 bg-slate-100 text-slate-700 rounded-xl text-xs font-semibold">Close</button>
                <button onclick="window.print()" class="px-4 py-1.5 bg-brand-600 text-white rounded-xl text-xs font-bold shadow"><i class="fa-solid fa-print mr-1"></i> Print Receipt</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Full Microfinance ERP Client Script -->
    <script src="~/js/microfinance.js" asp-append-version="true"></script>
}
