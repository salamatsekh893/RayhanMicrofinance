@page
@model IndexModel
@{
    ViewData["Title"] = "RPS Rayhan Tech - Microfinance ERP";
}

<div id="app" class="min-h-screen flex flex-col bg-slate-50">
    <!-- 1. LOGIN OVERLAY (shown if not logged in) -->
    <div id="loginOverlay" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/80 backdrop-blur-sm transition-all duration-300">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-8 border border-slate-100">
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-600 text-white shadow-lg shadow-brand-500/30 mb-3 text-2xl font-bold">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">RPS Rayhan Tech</h2>
                <p class="text-xs uppercase tracking-wider font-semibold text-brand-600 mt-0.5">Enterprise Microfinance ERP</p>
                <p class="text-slate-500 text-sm mt-2">Sign in to your branch terminal</p>
            </div>

            <form id="loginForm" class="space-y-4" onsubmit="event.preventDefault(); handleLogin();">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Username</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <i class="fa-solid fa-user text-sm"></i>
                        </span>
                        <input id="loginUsername" type="text" required value="admin"
                            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all font-medium"
                            placeholder="Enter username" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>
                        <input id="loginPassword" type="password" required value="AdminPassword123!"
                            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all font-medium"
                            placeholder="Enter password" />
                    </div>
                </div>

                <button type="submit" id="loginBtn"
                    class="w-full py-3 px-4 bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-semibold rounded-xl shadow-lg shadow-brand-500/25 transition-all duration-200 flex items-center justify-center space-x-2 text-sm mt-2">
                    <span>Sign In to ERP</span>
                    <i class="fa-solid fa-arrow-right text-xs"></i>
                </button>
            </form>

            <div class="mt-6 pt-5 border-t border-slate-100 text-center">
                <p class="text-xs text-slate-400 mb-2 font-medium">Quick Demo Accounts (1-Click Fill):</p>
                <div class="flex justify-center gap-2">
                    <button onclick="fillLogin('admin', 'AdminPassword123!')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-brand-50 hover:text-brand-700 text-slate-700 rounded-lg font-medium transition border border-slate-200">
                        <i class="fa-solid fa-shield-halved text-brand-600 mr-1"></i>Super Admin
                    </button>
                    <button onclick="fillLogin('manager', 'Manager123!')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-brand-50 hover:text-brand-700 text-slate-700 rounded-lg font-medium transition border border-slate-200">
                        <i class="fa-solid fa-briefcase text-blue-600 mr-1"></i>Manager
                    </button>
                    <button onclick="fillLogin('fieldofficer', 'Field123!')" class="px-2.5 py-1 text-xs bg-slate-100 hover:bg-brand-50 hover:text-brand-700 text-slate-700 rounded-lg font-medium transition border border-slate-200">
                        <i class="fa-solid fa-person-walking text-amber-600 mr-1"></i>Field Officer
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. MAIN APPLICATION WORKSPACE -->
    <div id="mainWorkspace" class="flex-1 flex overflow-hidden hidden">
        <!-- SIDEBAR -->
        <aside id="sidebar" class="w-64 bg-slate-900 text-slate-300 flex flex-col flex-shrink-0 transition-all duration-300 z-30">
            <!-- Brand -->
            <div class="h-16 flex items-center px-5 border-b border-slate-800 bg-slate-950/40">
                <div class="w-9 h-9 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold text-lg shadow-md mr-3">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                </div>
                <div class="truncate">
                    <h1 class="font-bold text-white text-base leading-tight tracking-tight">RPS Rayhan Tech</h1>
                    <p class="text-[10px] uppercase font-semibold text-brand-400 tracking-wider">Microfinance ERP</p>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
                <a href="#dashboard" onclick="switchTab('dashboard')" id="nav-dashboard"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl transition text-white bg-brand-600 shadow-sm">
                    <i class="fa-solid fa-chart-pie w-5 text-center mr-3"></i>
                    <span>Dashboard</span>
                </a>

                <div class="pt-3 pb-1 px-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Field & Operations</div>

                <a href="#customers" onclick="switchTab('customers')" id="nav-customers"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="fa-solid fa-users w-5 text-center mr-3"></i>
                    <span>Members & KYC</span>
                </a>

                <a href="#centers" onclick="switchTab('centers')" id="nav-centers"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="fa-solid fa-people-roof w-5 text-center mr-3"></i>
                    <span>Centers & JLG Groups</span>
                </a>

                <a href="#loans" onclick="switchTab('loans')" id="nav-loans"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="fa-solid fa-file-invoice-dollar w-5 text-center mr-3"></i>
                    <span>Loan Management</span>
                </a>

                <a href="#collections" onclick="switchTab('collections')" id="nav-collections"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="fa-solid fa-hand-holding-dollar w-5 text-center mr-3"></i>
                    <span>Field Collection Sheet</span>
                </a>

                <a href="#savings" onclick="switchTab('savings')" id="nav-savings"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="fa-solid fa-piggy-bank w-5 text-center mr-3"></i>
                    <span>Savings & Deposits</span>
                </a>

                <div class="pt-3 pb-1 px-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Finance & Accounts</div>

                <a href="#accounting" onclick="switchTab('accounting')" id="nav-accounting"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="fa-solid fa-book-journal-whills w-5 text-center mr-3"></i>
                    <span>Double-Entry Accounts</span>
                </a>

                <a href="#expenses" onclick="switchTab('expenses')" id="nav-expenses"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="fa-solid fa-receipt w-5 text-center mr-3"></i>
                    <span>Expenses & Incomes</span>
                </a>

                <div class="pt-3 pb-1 px-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Administration</div>

                <a href="#branches" onclick="switchTab('branches')" id="nav-branches"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="fa-solid fa-building-columns w-5 text-center mr-3"></i>
                    <span>Branches & Company</span>
                </a>

                <a href="#employees" onclick="switchTab('employees')" id="nav-employees"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="fa-solid fa-id-card-clip w-5 text-center mr-3"></i>
                    <span>Staff & Attendance</span>
                </a>

                <a href="#reports" onclick="switchTab('reports')" id="nav-reports"
                    class="nav-link flex items-center px-3.5 py-2.5 text-sm font-medium rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="fa-solid fa-chart-line w-5 text-center mr-3"></i>
                    <span>Audit & Reports</span>
                </a>
            </div>

            <!-- User profile footer -->
            <div class="p-3.5 border-t border-slate-800 bg-slate-950/60 flex items-center justify-between">
                <div class="flex items-center min-w-0 mr-2">
                    <div class="w-8 h-8 rounded-full bg-brand-700 text-white flex items-center justify-center font-bold text-xs mr-2.5 flex-shrink-0">
                        <span id="userAvatar">A</span>
                    </div>
                    <div class="truncate">
                        <p id="userNameDisplay" class="text-xs font-semibold text-white truncate">Administrator</p>
                        <p id="userRoleDisplay" class="text-[10px] text-brand-400 truncate font-medium">Super Admin</p>
                    </div>
                </div>
                <button onclick="handleLogout()" title="Logout" class="p-1.5 text-slate-400 hover:text-red-400 rounded-lg hover:bg-slate-800 transition">
                    <i class="fa-solid fa-arrow-right-from-bracket text-sm"></i>
                </button>
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
            <!-- TOP BAR -->
            <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between z-20 flex-shrink-0">
                <div class="flex items-center space-x-4">
                    <div class="flex items-center bg-slate-100 rounded-xl px-3 py-1.5 border border-slate-200">
                        <i class="fa-solid fa-location-dot text-brand-600 text-xs mr-2"></i>
                        <span class="text-xs font-semibold text-slate-600 mr-2">Branch:</span>
                        <select id="branchSelector" onchange="onBranchChange()" class="bg-transparent text-xs font-bold text-slate-800 focus:outline-none cursor-pointer">
                            <option value="">All Branches (Consolidated)</option>
                        </select>
                    </div>

                    <div class="hidden md:flex items-center text-xs font-medium text-slate-500 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200">
                        <i class="fa-regular fa-calendar-check text-slate-400 mr-2"></i>
                        <span id="liveDateTime">Loading date...</span>
                    </div>
                </div>

                <div class="flex items-center space-x-3">
                    <!-- Quick action buttons -->
                    <button onclick="openApplyLoanModal()" class="hidden sm:inline-flex items-center px-3.5 py-2 bg-brand-50 hover:bg-brand-100 text-brand-700 text-xs font-bold rounded-xl border border-brand-200 transition shadow-sm">
                        <i class="fa-solid fa-plus mr-1.5"></i> New Loan
                    </button>
                    <button onclick="switchTab('collections')" class="hidden sm:inline-flex items-center px-3.5 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-bold rounded-xl border border-blue-200 transition shadow-sm">
                        <i class="fa-solid fa-receipt mr-1.5"></i> Collect EMI
                    </button>
                    <button onclick="openRegisterCustomerModal()" class="inline-flex items-center px-3.5 py-2 bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white text-xs font-bold rounded-xl shadow-md shadow-brand-500/25 transition">
                        <i class="fa-solid fa-user-plus mr-1.5"></i> Add Member
                    </button>
                </div>
            </header>

            <!-- SCROLLABLE PAGE CONTAINER -->
            <main class="flex-1 overflow-y-auto p-6 space-y-6">
                <!-- VIEW 1: DASHBOARD -->
                <div id="view-dashboard" class="tab-view space-y-6">
                    <!-- KPI Banner -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <!-- Today Collection -->
                        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Today's Collection</p>
                                    <h3 id="statTodayCollection" class="text-2xl font-black text-slate-900 mt-1">₹0.00</h3>
                                    <p class="text-[11px] text-emerald-600 font-semibold mt-1 flex items-center">
                                        <i class="fa-solid fa-arrow-trend-up mr-1"></i> Cash & Bank deposits
                                    </p>
                                </div>
                                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                                    <i class="fa-solid fa-hand-holding-dollar"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Today Disbursement -->
                        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Today's Disbursement</p>
                                    <h3 id="statTodayDisbursement" class="text-2xl font-black text-slate-900 mt-1">₹0.00</h3>
                                    <p class="text-[11px] text-blue-600 font-semibold mt-1 flex items-center">
                                        <i class="fa-solid fa-money-bill-transfer mr-1"></i> Disbursed loans
                                    </p>
                                </div>
                                <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
                                    <i class="fa-solid fa-money-bill-wave"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Active Loan Portfolio -->
                        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Active Portfolio</p>
                                    <h3 id="statTotalPortfolio" class="text-2xl font-black text-slate-900 mt-1">₹0.00</h3>
                                    <p class="text-[11px] text-brand-600 font-semibold mt-1 flex items-center">
                                        <span id="statActiveLoansCount">0</span> Active Loans
                                    </p>
                                </div>
                                <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center text-xl">
                                    <i class="fa-solid fa-briefcase"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Overdue Loans -->
                        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Overdue Risk</p>
                                    <h3 id="statOverdueAmount" class="text-2xl font-black text-rose-600 mt-1">₹0.00</h3>
                                    <p class="text-[11px] text-rose-500 font-semibold mt-1 flex items-center">
                                        <span id="statOverdueCount">0</span> Defaulted / Overdue
                                    </p>
                                </div>
                                <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Secondary KPI Bar (Cash, Bank, Savings, Profit) -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="bg-white rounded-xl p-4 border border-slate-200/70 shadow-sm flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-base">
                                <i class="fa-solid fa-vault"></i>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold text-slate-400 uppercase">Cash in Hand</p>
                                <p id="statCashBalance" class="text-lg font-bold text-slate-800">₹0.00</p>
                            </div>
                        </div>

                        <div class="bg-white rounded-xl p-4 border border-slate-200/70 shadow-sm flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-base">
                                <i class="fa-solid fa-building-columns"></i>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold text-slate-400 uppercase">Bank Current Bal</p>
                                <p id="statBankBalance" class="text-lg font-bold text-slate-800">₹0.00</p>
                            </div>
                        </div>

                        <div class="bg-white rounded-xl p-4 border border-slate-200/70 shadow-sm flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-base">
                                <i class="fa-solid fa-piggy-bank"></i>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold text-slate-400 uppercase">Member Savings</p>
                                <p id="statTotalSavings" class="text-lg font-bold text-slate-800">₹0.00</p>
                            </div>
                        </div>

                        <div class="bg-white rounded-xl p-4 border border-slate-200/70 shadow-sm flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold text-base">
                                <i class="fa-solid fa-scale-balanced"></i>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold text-slate-400 uppercase">Net Monthly Profit</p>
                                <p id="statNetProfit" class="text-lg font-bold text-teal-600">₹0.00</p>
                            </div>
                        </div>
                    </div>

                    <!-- Charts & Performance Row -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- Chart Card -->
                        <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
                            <div class="flex items-center justify-between mb-4">
                                <div>
                                    <h4 class="text-base font-bold text-slate-900">Disbursement & Collection Trend</h4>
                                    <p class="text-xs text-slate-500">Monthly loan operations graph</p>
                                </div>
                                <span class="text-xs font-semibold px-2.5 py-1 bg-slate-100 text-slate-600 rounded-lg">Last 6 Months</span>
                            </div>
                            <div class="h-64">
                                <canvas id="monthlyTrendChart"></canvas>
                            </div>
                        </div>

                        <!-- Branch Performance Card -->
                        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col">
                            <h4 class="text-base font-bold text-slate-900 mb-1">Branch Portfolio Performance</h4>
                            <p class="text-xs text-slate-500 mb-4">Live recovery and loan status</p>
                            <div class="flex-1 overflow-y-auto space-y-3" id="branchPerformanceList">
                                <div class="text-center py-8 text-slate-400 text-sm">Loading branch statistics...</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- VIEW 2: CUSTOMERS / KYC -->
                <div id="view-customers" class="tab-view space-y-6 hidden">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="text-xl font-bold text-slate-900">Customer & KYC Management</h3>
                            <p class="text-xs text-slate-500">Borrowers, members, Aadhaar/PAN KYC, and biometrics</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="relative">
                                <input type="text" id="custSearchInput" onkeyup="searchCustomers()" placeholder="Search Aadhaar, Phone, Name..."
                                    class="pl-9 pr-4 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 w-64 shadow-sm" />
                                <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                            </div>
                            <button onclick="openRegisterCustomerModal()" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold rounded-xl shadow-md transition flex items-center">
                                <i class="fa-solid fa-user-plus mr-1.5"></i> Register New Member
                            </button>
                        </div>
                    </div>

                    <!-- Customers Table -->
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase tracking-wider font-semibold">
                                        <th class="py-3.5 px-4">Member ID</th>
                                        <th class="py-3.5 px-4">Full Name & Guardian</th>
                                        <th class="py-3.5 px-4">Phone</th>
                                        <th class="py-3.5 px-4">Branch / Center / Group</th>
                                        <th class="py-3.5 px-4">Aadhaar / KYC</th>
                                        <th class="py-3.5 px-4">Occupation</th>
                                        <th class="py-3.5 px-4 text-center">Status</th>
                                        <th class="py-3.5 px-4 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="customersTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                                    <tr>
                                        <td colspan="8" class="text-center py-8 text-slate-400">Loading members...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- VIEW 3: CENTERS & JLG GROUPS -->
                <div id="view-centers" class="tab-view space-y-6 hidden">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="text-xl font-bold text-slate-900">Centers & JLG Group Management</h3>
                            <p class="text-xs text-slate-500">Joint Liability Groups, center meetings, and field operations</p>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="openCreateCenterModal()" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold rounded-xl shadow transition">
                                <i class="fa-solid fa-plus mr-1"></i> New Center
                            </button>
                            <button onclick="openCreateGroupModal()" class="px-3.5 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold rounded-xl shadow transition">
                                <i class="fa-solid fa-plus mr-1"></i> New JLG Group
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Centers List -->
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4">
                            <h4 class="font-bold text-slate-900 text-sm flex items-center justify-between">
